# Copiez ce fichier en .env et remplissez seulement les services que vous utilisez.
# Ne commitez JAMAIS le fichier .env (il est ignoré par Git).

# Fournisseur d'images par défaut : local | fal | replicate | openai
FOURNISSEUR_IMAGES=local
# Fournisseur de voix par défaut : edge | elevenlabs
FOURNISSEUR_VOIX=edge

# https://fal.ai/dashboard/keys
FAL_KEY=
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
